# ---- Accounts and cloud storage (optional). Without these the app runs in demo mode. ----
# Firebase console -> Project settings -> Your apps -> Web app -> Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Live AI assistant (optional). Without a key, replies are simulated. ----
# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
ANTHROPIC_API_KEY=
# Optional overrides:
# AI_MODEL=claude-sonnet-5-5
# AI_MAX_TOKENS=1024
